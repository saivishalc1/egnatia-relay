# --- Required for a real deployment ---
PORT=3000
APP_URL=https://relay.egnatiaconstruction.com     # public URL (used for Google OAuth redirect)
APP_PASSWORD=change-me                            # single login password for Elona / office

# --- AI: leave blank for mock mode (templated drafts) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Gmail (Google Cloud Console → OAuth client, Web application) ---
# Authorized redirect URI must be: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---
DB_PATH=./data/relay.db
RULES_CRON=0 6 * * *       # nightly rules run, America/New_York
TZ=America/New_York
AUTO_SEED=true             # seeds sample data on first boot if the DB is empty (set false for Egnatia's real instance)
